# Dapatkan API key gratis di: https://console.groq.com/keys
# Copy file ini jadi .env lalu isi key-nya
VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Pembayaran DOKU (server only; jangan beri awalan VITE_)
DOKU_CLIENT_ID=isi_client_id_doku
DOKU_SECRET_KEY=isi_secret_key_doku
DOKU_ENV=sandbox
APP_URL=http://localhost:3000

# Supabase server-side database (service role key hanya di environment backend)
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key

# Buat token hex dengan: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_DASHBOARD_TOKEN=isi_token_admin_acak_panjang
